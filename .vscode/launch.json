{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tabloide (dispositivo)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_URL=https://tabloide-api.vercel.app/v1"]
    },
    {
      "name": "Tabloide (web)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--dart-define=API_URL=https://tabloide-api.vercel.app/v1",
        "--web-hostname=localhost",
        "--web-port=5173"
      ]
    }
  ]
}
